@page "/chat"
@using System.Text.Json
@using AgentMarketer.Web.Models
@inject HttpClient Http
@inject IJSRuntime JS

<style>
.company-briefs-review {
    margin-top: 1rem;
    padding: 1rem;
    background-color: #f8f9fa;
    border-radius: 0.5rem;
    border: 1px solid #dee2e6;
}

.briefs-container {
    max-height: 600px;
    overflow-y: auto;
}

.briefs-container h6 {
    color: #495057;
    font-weight: 600;
}

/* Flexbox grid layout for multiple cards */
.briefs-container {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

@@media (min-width: 768px) {
    .briefs-container {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        gap: 0.75rem;
    }
    
    .briefs-container .company-brief-card {
        flex: 1 1 calc(50% - 0.375rem);
        min-width: 300px;
        margin-bottom: 0;
    }
}

@@media (min-width: 1200px) {
    .briefs-container .company-brief-card {
        flex: 1 1 calc(33.333% - 0.5rem);
        min-width: 280px;
    }
}

.bulk-actions {
    text-align: center;
    padding-top: 1rem;
    border-top: 1px solid #dee2e6;
}

.bulk-actions .btn-group .btn {
    margin: 0 0.25rem;
}

.approval-buttons {
    margin-top: 1rem;
    text-align: center;
}

.approval-buttons .btn {
    margin: 0 0.25rem;
}

/* Chat message styling improvements */
.message.agent {
    background-color: #f8f9fa;
    border-left: 4px solid #007bff;
    padding: 1rem;
    margin: 0.5rem 0;
    border-radius: 0.5rem;
}

.message.user {
    background-color: #e3f2fd;
    border-left: 4px solid #2196f3;
    margin-left: 2rem;
    padding: 1rem;
    margin: 0.5rem 0;
    border-radius: 0.5rem;
}

.agent-name {
    font-weight: 600;
    color: #007bff;
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
}

.message-content {
    line-height: 1.6;
}

.message-time {
    font-size: 0.8rem;
    color: #6c757d;
    margin-top: 0.5rem;
    text-align: right;
}
</style>

<div class="chat-container">
    <div class="chat-header">
        <h3>🤖 Marketing Campaign Assistant</h3>
        <p>Describe your marketing goals and I'll help create a comprehensive campaign with human-in-the-loop approval</p>
        
        <div class="session-controls mb-3">
            <div class="row">
                <div class="col-md-6">
                    <label class="form-label">Current Session:</label>
                    <div class="input-group">
                        <input type="text" class="form-control" @bind="sessionId" placeholder="Session ID" />
                        <button class="btn btn-outline-secondary" @onclick="LoadExistingSession">Load</button>
                    </div>
                    <small class="text-muted">Session: @sessionId.Substring(0, Math.Min(8, sessionId.Length))...</small>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Available Sessions:</label>
                    <select class="form-select" @onchange="OnSessionSelected">
                        <option value="">Select an existing session...</option>
                        @foreach (var session in availableSessions)
                        {
                            <option value="@session">@session.Substring(0, Math.Min(8, session.Length))...</option>
                        }
                    </select>
                    <small class="text-muted">
                        <button class="btn btn-link btn-sm p-0" @onclick="LoadAvailableSessions">Refresh Sessions</button>
                    </small>
                </div>
            </div>
        </div>
    </div>

    <div class="chat-messages" @ref="messagesContainer">
        @foreach (var message in messages)
        {
            <div class="message @(message.IsUser ? "user" : "agent")">
                @if (!message.IsUser)
                {
                    <div class="agent-name">@message.AgentName</div>
                }
                <div class="message-content">
                    @((MarkupString)FormatMessage(message.Content))
                </div>
                @if (message.RequiresApproval && message.ApprovalData != null)
                {
                    <div class="company-briefs-review">
                        @if (TryParseCompanyBriefs(message.ApprovalData, out var briefs))
                        {
                            <div class="briefs-container">
                                <h6 class="mb-3">📋 Company Briefs for Review:</h6>
                                @foreach (var brief in briefs)
                                {
                                    <CompanyBriefReviewCard 
                                        Brief="@brief" 
                                        CampaignId="@GetCampaignIdFromMessage(message)"
                                        OnBriefUpdated="@HandleBriefUpdated" />
                                }
                                <div class="bulk-actions mt-3">
                                    <div class="btn-group">
                                        <button class="btn btn-success btn-sm" @onclick="() => ApproveAllBriefs(briefs)">
                                            ✅ Approve All Remaining
                                        </button>
                                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => RequestChanges(message.SessionId)">
                                            💬 Request General Changes
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <!-- Fallback to basic buttons if parsing fails -->
                            <div class="approval-buttons">
                                <button class="btn btn-success btn-sm" @onclick="() => ApproveAll(message.SessionId)">
                                    ✅ Approve All
                                </button>
                                <button class="btn btn-warning btn-sm" @onclick="() => RequestChanges(message.SessionId)">
                                    ✏️ Request Changes
                                </button>
                            </div>
                        }
                    </div>
                }
                <div class="message-time">@message.Timestamp.ToString("HH:mm")</div>
            </div>
        }
        @if (isTyping)
        {
            <div class="message agent typing">
                <div class="agent-name">Agent</div>
                <div class="typing-indicator">
                    <span></span><span></span><span></span>
                </div>
            </div>
        }
    </div>

    <div class="chat-input">
        <div class="input-group">
            <input type="text" class="form-control" @bind="currentMessage" @onkeypress="HandleKeyPress" 
                   placeholder="Describe your marketing campaign goals..." disabled="@isProcessing" />
            <button class="btn btn-primary" @onclick="SendMessage" disabled="@(isProcessing || string.IsNullOrWhiteSpace(currentMessage))">
                @if (isProcessing)
                {
                    <span class="spinner-border spinner-border-sm" role="status"></span>
                }
                else
                {
                    <span>Send</span>
                }
            </button>
        </div>
    </div>

    @if (messages.Count == 0)
    {
        <div class="example-prompts">
            <h5>💡 Try these examples:</h5>
            <button class="btn btn-outline-secondary btn-sm" @onclick='() => SetMessage("Create a campaign targeting top 10 retail companies with landing pages and email content")'>
                Create retail campaign
            </button>
            <button class="btn btn-outline-secondary btn-sm" @onclick='() => SetMessage("Build a comprehensive marketing strategy for manufacturing companies with social media and ads")'>
                Manufacturing strategy
            </button>
            <button class="btn btn-outline-secondary btn-sm" @onclick='() => SetMessage("Generate personalized content for technology companies including landing pages and LinkedIn posts")'>
                Tech company content
            </button>
        </div>
    }
</div>

@code {
    private List<SimpleChatMessage> messages = new();
    private string currentMessage = "";
    private bool isProcessing = false;
    private bool isTyping = false;
    private ElementReference messagesContainer;
    private string sessionId = Guid.NewGuid().ToString();
    private List<string> availableSessions = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadAvailableSessions();
            await ScrollToBottom();
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(currentMessage) || isProcessing) return;

        var userMessage = currentMessage.Trim();
        currentMessage = "";
        isProcessing = true;
        isTyping = true;

        // Add user message
        messages.Add(new SimpleChatMessage
        {
            Content = userMessage,
            IsUser = true,
            Timestamp = DateTime.Now,
            SessionId = sessionId,
            CampaignSessionId = ""
        });

        StateHasChanged();
        await ScrollToBottom();

        try
        {
            // Call your existing orchestration through the bridge
            var response = await Http.PostAsJsonAsync("/api/simplechat/message", new SimpleChatRequest
            {
                Message = userMessage,
                SessionId = sessionId
            });

            if (response.IsSuccessStatusCode)
            {
                var chatResponse = await response.Content.ReadFromJsonAsync<ChatResponse>();
                
                if (chatResponse != null)
                {
                    var newMessage = new SimpleChatMessage
                    {
                        Content = chatResponse.Message,
                        IsUser = false,
                        AgentName = chatResponse.AgentName,
                        Timestamp = DateTime.Now,
                        SessionId = sessionId,
                        CampaignSessionId = chatResponse.CampaignSessionId,
                        RequiresApproval = chatResponse.RequiresApproval,
                        ApprovalData = chatResponse.ApprovalData
                    };
                    
                    // DEBUG: Log the new message
                    _ = JS.InvokeVoidAsync("console.log", $"[DEBUG] SendMessage - New message created with CampaignSessionId: {newMessage.CampaignSessionId}");
                    
                    messages.Add(newMessage);
                }
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                messages.Add(new SimpleChatMessage
                {
                    Content = $"Sorry, I encountered an error: {errorContent}. Please try again.",
                    IsUser = false,
                    AgentName = "System",
                    Timestamp = DateTime.Now,
                    SessionId = sessionId,
                    CampaignSessionId = ""
                });
            }
        }
        catch (Exception ex)
        {
            messages.Add(new SimpleChatMessage
            {
                Content = $"Error: {ex.Message}",
                IsUser = false,
                AgentName = "System", 
                Timestamp = DateTime.Now,
                SessionId = sessionId,
                CampaignSessionId = ""
            });
        }
        finally
        {
            isProcessing = false;
            isTyping = false;
            StateHasChanged();
            await ScrollToBottom();
        }
    }

    private async Task ApproveAll(string sessionId)
    {
        currentMessage = "approve all";
        await SendMessage();
    }

    private async Task RequestChanges(string sessionId)
    {
        currentMessage = "I'd like to request some changes to the company briefs";
        await SendMessage();
    }

    private bool TryParseCompanyBriefs(object? approvalData, out List<CompanyBriefResponse> briefs)
    {
        briefs = new List<CompanyBriefResponse>();
        
        // DEBUG: Log approval data
        _ = JS.InvokeVoidAsync("console.log", $"[DEBUG] TryParseCompanyBriefs - approvalData is null: {approvalData == null}");
        
        if (approvalData == null) return false;
        
        try
        {
            // Try to parse the approval data as company briefs
            var jsonElement = (JsonElement)approvalData;
            
            if (jsonElement.ValueKind == JsonValueKind.Array)
            {
                // First try to deserialize as CompanyBrief (from bridge), then convert to CompanyBriefResponse
                var options = new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                };
                var bridgeBriefs = JsonSerializer.Deserialize<List<CompanyBriefFromBridge>>(jsonElement.GetRawText(),options);
                
               
                if (bridgeBriefs?.Any() == true)
                {
                    briefs = bridgeBriefs.Select(b => new CompanyBriefResponse
                    {
                        CompanyId = b.CompanyId,
                        CompanyName = b.CompanyName,
                        Content = b.Content,
                        Brief = b.Content,
                        Industry = b.Industry,
                        CampaignId = sessionId, // Use current session as campaign ID
                        Status = ApprovalStatus.Pending,
                        GeneratedAt = DateTime.Now,
                        KeyMessages = b.KeyMessages,
                        TargetAudience = b.TargetAudience,
                        EstimatedBudget = b.EstimatedBudget,
                        ProjectedReach = b.ProjectedReach
                    }).ToList();
                    return true;
                }
                
                // Fallback: try direct deserialization as CompanyBriefResponse
                briefs = JsonSerializer.Deserialize<List<CompanyBriefResponse>>(jsonElement.GetRawText()) ?? new();
                return briefs.Any();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error parsing company briefs: {ex.Message}");
        }
        
        return false;
    }

    // Helper class to match the bridge model
    public class CompanyBriefFromBridge
    {
        public string CompanyId { get; set; } = "";
        public string CompanyName { get; set; } = "";
        public string Content { get; set; } = "";
        public string Industry { get; set; } = "";
        public bool RequiresApproval { get; set; }
        public List<string>? KeyMessages { get; set; }
        public string? TargetAudience { get; set; }
        public int EstimatedBudget { get; set; }
        public int ProjectedReach { get; set; }
    }

    private string GetCampaignIdFromMessage(SimpleChatMessage message)
    {
        // Use the campaign session ID from the message, fallback to session ID if not available
        var campaignId = !string.IsNullOrEmpty(message.CampaignSessionId) ? message.CampaignSessionId : message.SessionId;
        
        // DEBUG: Log to browser console
        _ = JS.InvokeVoidAsync("console.log", $"[DEBUG] GetCampaignIdFromMessage - SessionId: {message.SessionId}, CampaignSessionId: {message.CampaignSessionId}, Using: {campaignId}");
        
        return campaignId;
    }

    private async Task HandleBriefUpdated(CompanyBriefResponse updatedBrief)
    {
        // Find the message with approval data that needs updating
        var approvalMessage = messages.LastOrDefault(m => m.RequiresApproval && !string.IsNullOrEmpty(m.ApprovalData?.ToString()));
        
        if (approvalMessage != null && TryParseCompanyBriefs(approvalMessage.ApprovalData?.ToString() ?? "", out var briefs))
        {
            // Update the brief in the list by creating a new one with updated properties
            for (int i = 0; i < briefs.Count; i++)
            {
                if (briefs[i].CompanyId == updatedBrief.CompanyId)
                {
                    briefs[i] = briefs[i] with 
                    {
                        Status = updatedBrief.Status,
                        ApproverFeedback = updatedBrief.ApproverFeedback,
                        ApprovedAt = updatedBrief.ApprovedAt,
                        Content = updatedBrief.Content
                    };
                    break;
                }
            }

            // Check if all briefs are approved
            var pendingBriefs = briefs.Where(b => b.Status == ApprovalStatus.Pending).ToList();
            var approvedBriefs = briefs.Where(b => b.Status == ApprovalStatus.Approved).ToList();
            var rejectedBriefs = briefs.Where(b => b.Status == ApprovalStatus.Rejected).ToList();

            if (pendingBriefs.Count == 0)
            {
                // All briefs have been processed
                if (approvedBriefs.Count > 0 && rejectedBriefs.Count == 0)
                {
                    // All briefs approved - proceed to content generation
                    await ProceedToContentGeneration(approvalMessage.CampaignSessionId, approvedBriefs);
                }
                else if (approvedBriefs.Count > 0)
                {
                    // Some approved, some rejected - proceed with approved ones
                    await ProceedToContentGeneration(approvalMessage.CampaignSessionId, approvedBriefs);
                }
                else
                {
                    // All rejected - send feedback message
                    messages.Add(new SimpleChatMessage
                    {
                        Content = "All company briefs have been rejected. You can request a new campaign or ask for revisions to the briefs.",
                        IsUser = false,
                        AgentName = "Assistant",
                        Timestamp = DateTime.Now,
                        SessionId = sessionId
                    });
                }
            }
            else
            {
                // Still have pending briefs - update the UI to show current state
                var statusMessage = $"Brief for {updatedBrief.CompanyName} has been {updatedBrief.Status.ToString().ToLower()}. ";
                statusMessage += $"Remaining briefs to review: {pendingBriefs.Count}";
                
                messages.Add(new SimpleChatMessage
                {
                    Content = statusMessage,
                    IsUser = false,
                    AgentName = "Assistant",
                    Timestamp = DateTime.Now,
                    SessionId = sessionId
                });
            }

            StateHasChanged();
            await ScrollToBottom();
        }
    }

    private async Task ApproveAllBriefs(List<CompanyBriefResponse> briefs)
    {
        var pendingBriefs = briefs.Where(b => b.Status == ApprovalStatus.Pending).ToList();
        if (pendingBriefs.Any())
        {
            try
            {
                // Approve all pending briefs
                foreach (var brief in pendingBriefs)
                {
                    var request = new ApprovalRequest
                    {
                        Action = ApprovalStatus.Approved,
                        Feedback = "Approved via 'Approve All' action",
                        IsApproved = true,
                        ApprovedBy = "User"
                    };

                    var response = await Http.PostAsJsonAsync($"https://localhost:7001/api/approvals/campaigns/{brief.CampaignId}/briefs/{brief.CompanyId}/approve", request);
                    
                    if (response.IsSuccessStatusCode)
                    {
                        // Update brief status in the list
                        for (int i = 0; i < briefs.Count; i++)
                        {
                            if (briefs[i].CompanyId == brief.CompanyId)
                            {
                                briefs[i] = briefs[i] with 
                                {
                                    Status = ApprovalStatus.Approved,
                                    ApproverFeedback = "Approved via 'Approve All' action",
                                    ApprovedAt = DateTime.Now
                                };
                                break;
                            }
                        }
                    }
                }

                // Get the campaign session ID from the first brief
                var campaignSessionId = briefs.FirstOrDefault()?.CampaignId;
                if (!string.IsNullOrEmpty(campaignSessionId))
                {
                    await ProceedToContentGeneration(campaignSessionId, briefs.Where(b => b.Status == ApprovalStatus.Approved).ToList());
                }
            }
            catch (Exception ex)
            {
                messages.Add(new SimpleChatMessage
                {
                    Content = $"Error approving all briefs: {ex.Message}",
                    IsUser = false,
                    AgentName = "Assistant",
                    Timestamp = DateTime.Now,
                    SessionId = sessionId
                });
            }

            StateHasChanged();
            await ScrollToBottom();
        }
    }

    private void SetMessage(string message)
    {
        currentMessage = message;
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }

    private string FormatMessage(string content)
    {
        // Simple markdown-like formatting
        return content
            .Replace("\n", "<br>")
            .Replace("**", "<strong>")
            .Replace("**", "</strong>");
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await JS.InvokeVoidAsync("scrollToBottom", messagesContainer);
        }
        catch
        {
            // Ignore JS interop errors
        }
    }

    private async Task LoadAvailableSessions()
    {
        try
        {
            var response = await Http.GetAsync("https://localhost:7001/api/sessions");
            if (response.IsSuccessStatusCode)
            {
                availableSessions = await response.Content.ReadFromJsonAsync<List<string>>() ?? new();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading sessions: {ex.Message}");
        }
    }

    private async Task OnSessionSelected(ChangeEventArgs e)
    {
        var selectedSession = e.Value?.ToString();
        if (!string.IsNullOrEmpty(selectedSession))
        {
            sessionId = selectedSession;
            await LoadSessionBriefs();
            StateHasChanged();
        }
    }

    private async Task LoadExistingSession()
    {
        if (!string.IsNullOrEmpty(sessionId))
        {
            await LoadSessionBriefs();
        }
    }

    private async Task LoadSessionBriefs()
    {
        try
        {
            var response = await Http.GetAsync($"https://localhost:7001/api/sessions/{sessionId}/briefs");
            if (response.IsSuccessStatusCode)
            {
                var briefs = await response.Content.ReadFromJsonAsync<List<CompanyBriefFromBridge>>();
                if (briefs?.Any() == true)
                {
                    // Create a message showing the briefs for approval
                    var briefResponses = briefs.Select(b => new CompanyBriefResponse
                    {
                        CompanyId = b.CompanyId,
                        CompanyName = b.CompanyName,
                        Content = b.Content,
                        Brief = b.Content,
                        Industry = b.Industry,
                        CampaignId = sessionId,
                        Status = ApprovalStatus.Pending,
                        GeneratedAt = DateTime.Now,
                        KeyMessages = b.KeyMessages,
                        TargetAudience = b.TargetAudience,
                        EstimatedBudget = b.EstimatedBudget,
                        ProjectedReach = b.ProjectedReach
                    }).ToList();

                    // Add a message to show the loaded briefs
                    messages.Add(new SimpleChatMessage
                    {
                        Content = $"Loaded session {sessionId.Substring(0, 8)}... with {briefs.Count} company briefs pending approval.",
                        IsUser = false,
                        AgentName = "System",
                        Timestamp = DateTime.Now,
                        SessionId = sessionId,
                        CampaignSessionId = sessionId, // Use session ID as campaign ID for loaded sessions
                        RequiresApproval = true,
                        ApprovalData = briefResponses
                    });
                    StateHasChanged();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading session briefs: {ex.Message}");
        }
    }

    private async Task ProceedToContentGeneration(string campaignSessionId, List<CompanyBriefResponse> approvedBriefs)
    {
        try
        {
            // Call the continue campaign execution endpoint
            var response = await Http.PostAsync($"https://localhost:7001/api/approvals/campaigns/{campaignSessionId}/continue", null);
            
            if (response.IsSuccessStatusCode)
            {
                var continueResponse = await response.Content.ReadAsStringAsync();
                
                messages.Add(new SimpleChatMessage
                {
                    Content = $"🎉 **All briefs approved!** ({approvedBriefs.Count} companies)\n\n" +
                             $"**Approved Companies:**\n" +
                             string.Join("\n", approvedBriefs.Select(b => $"• {b.CompanyName}")) +
                             $"\n\n**Next Steps:**\n" +
                             $"✅ Starting content generation for approved companies...\n" +
                             $"📧 Email campaigns\n📄 Landing pages\n📱 Social media content\n🎯 Targeted ads\n\n" +
                             $"{continueResponse}",
                    IsUser = false,
                    AgentName = "Sequential Orchestration",
                    Timestamp = DateTime.Now,
                    SessionId = sessionId,
                    CampaignSessionId = campaignSessionId
                });
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                messages.Add(new SimpleChatMessage
                {
                    Content = $"✅ All briefs approved for {approvedBriefs.Count} companies!\n\n" +
                             "Ready to proceed with content generation. " +
                             $"However, there was an issue starting the next phase: {error}",
                    IsUser = false,
                    AgentName = "Assistant",
                    Timestamp = DateTime.Now,
                    SessionId = sessionId
                });
            }
        }
        catch (Exception)
        {
            messages.Add(new SimpleChatMessage
            {
                Content = $"✅ All briefs approved for {approvedBriefs.Count} companies!\n\n" +
                         $"**Approved Companies:**\n" +
                         string.Join("\n", approvedBriefs.Select(b => $"• {b.CompanyName}")) +
                         "\n\nReady to proceed with content generation. You can now request specific content types or continue with the campaign execution.",
                IsUser = false,
                AgentName = "Assistant",
                Timestamp = DateTime.Now,
                SessionId = sessionId
            });
        }
    }

    public class SimpleChatMessage
    {
        public string Content { get; set; } = "";
        public bool IsUser { get; set; }
        public string AgentName { get; set; } = "";
        public DateTime Timestamp { get; set; }
        public string SessionId { get; set; } = "";
        public string CampaignSessionId { get; set; } = "";
        public bool RequiresApproval { get; set; }
        public object? ApprovalData { get; set; }
    }

    public class SimpleChatRequest
    {
        public string Message { get; set; } = "";
        public string? SessionId { get; set; }
    }

    public class ChatResponse
    {
        public string SessionId { get; set; } = "";
        public string CampaignSessionId { get; set; } = "";
        public string AgentName { get; set; } = "";
        public string Message { get; set; } = "";
        public int MessageType { get; set; }
        public bool RequiresApproval { get; set; }
        public object? ApprovalData { get; set; }
    }
}
