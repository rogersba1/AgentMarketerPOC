@page "/"
@inject NavigationManager Navigation

<PageTitle>Marketing Campaign Agent</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header text-center">
                    <h3>🤖 Marketing Campaign Assistant</h3>
                </div>
                <div class="card-body text-center">
                    <h5 class="card-title">Welcome to the Campaign Orchestration System</h5>
                    <p class="card-text">
                        This system helps you create comprehensive marketing campaigns with human-in-the-loop approval for company briefs.
                    </p>
                    <p class="text-muted mb-4">
                        The chat interface includes features for reviewing and approving individual company briefs before content generation.
                    </p>
                    <button class="btn btn-primary btn-lg" @onclick="NavigateToChat">
                        🚀 Start New Campaign
                    </button>
                </div>
                <div class="card-footer text-muted text-center">
                    <small>
                        Features: Company Discovery • Brief Generation • Human Approval • Content Creation
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private void NavigateToChat()
    {
        Navigation.NavigateTo("/chat");
    }
}
